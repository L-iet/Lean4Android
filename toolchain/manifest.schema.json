{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean4android.org/schemas/toolchain-manifest-v1.json",
  "title": "Lean4Android toolchain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolchainId", "leanVersion", "leanCommit", "ndkVersion", "abi", "minimumApi", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "toolchainId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "leanVersion": { "type": "string" },
    "leanCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ndkVersion": { "type": "string" },
    "abi": { "const": "arm64-v8a" },
    "minimumApi": { "type": "integer", "minimum": 29 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "kind"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "enum": ["executable", "shared-library", "lean-data", "source", "license"] }
        }
      }
    }
  }
}

